{
  "name": "hardware-stock-system",
  "version": "1.0.0",
  "description": "ระบบจัดการสต็อกอุปกรณ์ไอที (Hardware Stock Management System) - รับเข้า / เบิกออก / คืน / ปรับปรุง / รายงาน",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
