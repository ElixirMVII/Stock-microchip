; ============================================================
;  การตั้งค่าระบบจัดการสต็อกอุปกรณ์ไอที
;  คัดลอกไฟล์นี้เป็น config.ini แล้วแก้ค่าให้ตรงกับเซิร์ฟเวอร์จริง
;  (config.ini ไม่ถูก track ใน git เพราะมีรหัสผ่าน)
;  รูปแบบเดียวกับโปรเจกต์อื่นในองค์กร จึงใช้เซิร์ฟเวอร์ MySQL ตัวเดียวกันได้
; ============================================================

[database]
host = 127.0.0.1
port = 3306
user = stock_app
password = เปลี่ยนรหัสผ่านตรงนี้
; ชื่อฐานข้อมูลของระบบสต็อก
name = Stock-MC
pool_size = 8
connect_timeout = 10

[server]
host = 0.0.0.0
port = 3000
; ตั้งเป็น true เมื่อเปิดผ่าน HTTPS หรือหลัง reverse proxy ที่เป็น HTTPS
https = false

[session]
; ต้องเปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนใช้งานจริง
secret = change-me-in-production

[setup]
; ใช้เฉพาะตอนสร้างผู้ดูแลระบบครั้งแรกเท่านั้น
admin_password = admin1234
